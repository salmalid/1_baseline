{
    "pretrained_model_name_or_path": "stabilityai/stable-diffusion-3.5-medium",
    "output_dir": "sd35_pathology_lora",
    "train_data_dir": "",
    "captions_file": "data/all_pathologies.json",
    "resolution": 512,
    "train_batch_size": 1,
    "num_train_epochs": 10,
    "checkpointing_steps": 500,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.0001,
    "lr_scheduler": "constant",
    "lr_warmup_steps": 0,
    "mixed_precision": "bf16",
    "report_to": "wandb",
    "tracker_project_name": "train_sd35_pathology_lora",
    "validation_prompt": [
        "Chest X-ray of a patient showing Atelectasis",
        "Chest X-ray of a patient showing Cardiomegaly",
        "Chest X-ray of a patient showing Consolidation",
        "Chest X-ray of a patient showing Edema",
        "Chest X-ray of a patient showing Enlarged Cardiomediastinum",
        "Chest X-ray of a patient showing Fracture",
        "Chest X-ray of a patient showing Lung Lesion",
        "Chest X-ray of a patient showing Lung Opacity",
        "Chest X-ray of a patient showing Pleural Effusion",
        "Chest X-ray of a patient showing Pleural Other",
        "Chest X-ray of a patient showing Pneumonia",
        "Chest X-ray of a patient showing Pneumothorax"
    ],
    "num_validation_images": 1,
    "validation_steps": 250,
    "generate_height": 512,
    "generate_width": 512,
    "seed": 42,
    "guidance_scale": 3.0,
    "num_inference_steps": 28,
    "rank": 32,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_weight_decay": 0.01,
    "adam_epsilon": 1e-08,
    "max_grad_norm": 1.0,
    "use_8bit_adam": false,
    "max_sequence_length": 256,
    "use_cached_latents": true,
    "latent_cache_suffix": "_latents_512.pt",
    "latent_cache_dir": "filtered_dataset/cached_latents",
    "embed_dir": "filtered_dataset/hiddenstate",
    "allow_tf32": true,
    "weighting_scheme": "logit_normal",
    "logit_mean": 0.0,
    "logit_std": 1.0,
    "mode_scale": 1.29,
    "precondition_outputs": 1,
    "validation_embeds": [
        "validation_embeds/val_0_embeds.pt",
        "validation_embeds/val_1_embeds.pt",
        "validation_embeds/val_2_embeds.pt",
        "validation_embeds/val_3_embeds.pt",
        "validation_embeds/val_4_embeds.pt",
        "validation_embeds/val_5_embeds.pt",
        "validation_embeds/val_6_embeds.pt",
        "validation_embeds/val_7_embeds.pt",
        "validation_embeds/val_8_embeds.pt",
        "validation_embeds/val_9_embeds.pt",
        "validation_embeds/val_10_embeds.pt",
        "validation_embeds/val_11_embeds.pt"
    ],
    "negative_validation_embed": "validation_embeds/negative_embeds.pt",
    "validation_embeds_dir": "validation_embeds"
}